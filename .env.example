# Default: load Lux 9B baked into the image. Leave MODEL_PATH unset.
MODEL_ID=vllm-sr/Decision-2.0-Lux-9B

# Model Store: configure the endpoint's Model field with the repository and
# pinned revision from models.json. The worker detects the cached snapshot.
# Otherwise attach writable storage; missing components download once and persist.
# MODEL_ID=vllm-sr/Decision-2.0-Vega-27B
# MODEL_ROOT=/runpod-volume/models
# Increase Runpod's worker initialization window for large first-use downloads:
# RUNPOD_INIT_TIMEOUT=3600
# MODEL_DOWNLOAD_TIMEOUT=1800
# Optional preloaded directories (explicit paths are loaded without downloading):
# MODEL_PATH=/runpod-volume/my-vega
# BASE_MODEL_PATH=/runpod-volume/my-qwen-base

# GPU runtime (must match the selected model's hardware requirements).
DEVICE=cuda:0
MAX_QUESTIONS=8
MAX_INPUT_BYTES=131072
