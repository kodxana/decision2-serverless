# Lux 9B and the Vega 27B adapter are baked in; Lux 9B is the default.
# Change MODEL_ID to select another package. Leave MODEL_PATH unset.
MODEL_ID=vllm-sr/Decision-2.0-Lux-9B

# Kai, Eos, Sol, and Nox use Model Store or download once to a network volume.
# For Model Store, use the selected repo and its pinned revision from models.json.

# Vega alone needs an external Qwen base. Supply it through one of:
# - Model Store: Qwen/Qwen3.8-27B at revision 1d4bf0f2ff6012fd82039f2fa52739d0dd7c60c0
# - A network volume with 70 GB free: Qwen downloads once and persists
# - BASE_MODEL_PATH pointing to a preloaded directory with the pinned Qwen files
# MODEL_ID=vllm-sr/Decision-2.0-Vega-27B
# MODEL_ROOT=/runpod-volume/models
# Increase Runpod's worker initialization window for large first-use downloads:
# RUNPOD_INIT_TIMEOUT=3600
# MODEL_DOWNLOAD_TIMEOUT=1800
# Optional preloaded base (loaded without downloading):
# BASE_MODEL_PATH=/runpod-volume/my-qwen-base

# GPU runtime (must match the selected model's hardware requirements).
DEVICE=cuda:0
MAX_QUESTIONS=8
MAX_INPUT_BYTES=131072
